# ==========================================================================
# SucreGas - Proteccion del backend
# --------------------------------------------------------------------------
# Evita que se puedan DESCARGAR directamente archivos internos
# (config.php, db.php, schema.sql, etc.) desde el navegador.
# NO afecta a api.php, que es el unico que debe responder.
# ==========================================================================

# Sin listado de directorios
Options -Indexes

# Bloquear archivos sensibles por extension
<FilesMatch "\.(sql|log|ini|bak|old|md|json|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloquear config.php y db.php (solo los usa api.php internamente)
<FilesMatch "^(config|db)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
